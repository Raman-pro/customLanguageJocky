// exercise arithmetic, precedence, unary ops
fn main() {
    let a: int = 10;
    let b: int = 3;
    print(a + b * 2);     // 16
    print((a + b) * 2);   // 26
    print(a - b);         // 7
    print(a / b);         // 3
    print(a % b);         // 1
    print(-a + 5);        // -5
    print(a == 10);       // true
    print(a != 10);       // false
    print(a < b);         // false
    print(a >= 10);       // true
}